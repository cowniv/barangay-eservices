generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Staff {
  id           String       @id @default(cuid())
  username     String       @unique
  name         String
  role         String       // clerk | approver | treasurer
  passwordHash String
  sessions     Session[]
  transitions  Transition[]
}

model Session {
  id        String   @id // random token stored in the cookie
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  staffId   String
  expiresAt DateTime
}

model Request {
  id          String       @id @default(cuid())
  ref         String       @unique
  docType     String       // clearance | indigency | residency
  status      String       @default("SUBMITTED")
  fullName    String
  address     String
  birthdate   String
  yearsOfResidency Int
  purpose     String
  contact     String
  feeCents    Int?
  paymentRef  String?
  paidAt      DateTime?
  issuedAt    DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  transitions Transition[]

  @@index([status])
}

model Transition {
